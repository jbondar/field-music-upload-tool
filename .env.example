# ---------------------------------------------------------------- routing
# Empty when served at a domain root; "/upload" when proxied to a subpath.
BASE_PATH=/upload

# ----------------------------------------------------------- google oauth
# From console.cloud.google.com -> APIs & Services -> Credentials ->
# OAuth client ID -> Web application. The redirect URI below must be listed
# there character for character.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://jakebondar.com/upload/callback

# --------------------------------------------------------------- sessions
# openssl rand -hex 32
SESSION_SECRET=
COOKIE_SECURE=true

# --------------------------------------------------------------- access
# Always allowed, comma separated. Anyone else needs an invite code.
ALLOWED_EMAILS=jakebondar@gmail.com
# Can mint invite codes and review held uploads.
ADMIN_EMAILS=jakebondar@gmail.com

# ------------------------------------------------------------ filesystem
# Paths as seen inside the container.
MUSIC_DIR=/music
STAGING_DIR=/staging
STATE_DIR=/state

# ---------------------------------------------------------------- limits
MAX_FILE_MB=1024
MAX_SHOW_MB=8192
MAX_FILES_PER_SHOW=80

# Move a show into the library automatically once every file decodes cleanly
# and no folder for that show exists yet. Set false to approve each one.
AUTO_PROMOTE=true
